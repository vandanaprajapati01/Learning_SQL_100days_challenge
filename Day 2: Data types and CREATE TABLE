CREATE TABLE Payments (
    PaymentID      INT           PRIMARY KEY,   -- whole number, unique ID
    OrderID        INT           NOT NULL,      -- whole number, links to Orders
    Amount         DECIMAL(18,2) NOT NULL,      -- exact decimal for money
    PaymentDate    DATETIME2     NOT NULL,      -- date and time
    PaymentMethod  VARCHAR(20)   NOT NULL,      -- short text: UPI, Card, COD
    IsSuccessful   BIT           NOT NULL       -- 1 = yes, 0 = no (last line: no comma)
);
